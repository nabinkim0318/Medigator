# Synthetic demo only. DEMO_MODE does not make real identifiers safe.
DEMO_MODE=true
SYNTHETIC_DATA_ONLY=true
# Shared demo operator password for local/portfolio use — not production IAM.
DEMO_ACCESS_CODE=replace-me-locally

# Optional. Leave blank for deterministic local startup/health checks.
# LLM-backed requests require a valid key; Docker smoke does not.
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=3500
DB_URL=sqlite:///data/medigator.db
# Canonical Docker/CI startup keeps RAG off to avoid model downloads.
ENABLE_RAG=false
# Retrieval strategy for the synthetic/demo RAG runtime.
# Supported: bm25, vector, hybrid
# Default is bm25 because it performed best on the committed frozen fixture.
RAG_RETRIEVAL_MODE=bm25
# The frozen fixture favors unexpanded BM25; opt in only for experiments.
BM25_QUERY_EXPANSION=false
