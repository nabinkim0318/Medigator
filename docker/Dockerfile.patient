# Optional built patient frontend for the two-app local demo.
# Not part of the canonical reproducibility gate or a production deployment.
FROM node:18-alpine

WORKDIR /app

# Use the repository lockfile for reproducible dependencies.
COPY package.json package-lock.json ./
RUN npm ci

COPY src ./src
COPY public ./public
COPY next.config.ts tsconfig.json tailwind.config.ts postcss.config.js postcss.config.mjs ./

# Build patient-specific frontend
ENV NEXT_PUBLIC_APP_TYPE=patient
RUN npm run build

# Expose port 3000
EXPOSE 3000

# Start patient frontend
CMD ["npm", "run", "start:patient"]
