# Optional built doctor frontend for the two-app local demo.
# Not part of the canonical reproducibility gate or a production deployment.
FROM node:18-alpine

WORKDIR /app

# Use the repository lockfile for reproducible dependencies.
COPY package.json package-lock.json ./
RUN npm ci

COPY src ./src
COPY public ./public
COPY next.config.ts tsconfig.json tailwind.config.ts postcss.config.js postcss.config.mjs ./

# Build doctor-specific frontend
ENV NEXT_PUBLIC_APP_TYPE=doctor
RUN npm run build

# Expose port 3001
EXPOSE 3001

# Start doctor frontend
CMD ["npm", "run", "start:doctor"]
